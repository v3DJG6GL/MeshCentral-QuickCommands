// ---- actions ----
function setFilter(g) { state.filter = g; render(); }
function select(id) { state.selected = id; renderDeck(); renderDrawer(); if (id) { var f = document.getElementById('fName'); if (f && document.activeElement.tagName != 'INPUT' && document.activeElement.tagName != 'TEXTAREA') f.focus(); } }
function setField(field, value, typing) {
  var c = byId(state.selected); if (c == null) return;
  c[field] = value; markDirty();
  if (typing) { // keep focus, just refresh the deck key and title
    renderDeck(); renderSummary();
    var t = document.querySelector('.drawerH .t'); if (t && field == 'name') t.textContent = c.name;
  } else { render(); }
}
function setTermView(v) { config.settings.terminalView = v; markDirty(); renderSide(); }
function addCommand(group) {
  if (group == null && state.filter) group = state.filter;
  var c = { id: uid(), name: 'New command', group: group || '', shell: 'cmd', command: '', mode: 'run', runAs: 0, showTerminal: true, showDesktop: false, showGeneral: false, confirm: false, color: '', description: '' };
  config.commands.push(c); state.selected = c.id; markDirty(); render();
  var f = document.getElementById('fName'); if (f) { f.focus(); f.select(); }
}
function duplicateCommand() {
  var c = byId(state.selected); if (c == null) return;
  var n = JSON.parse(JSON.stringify(c)); n.id = uid(); n.name = c.name + ' (copy)';
  config.commands.splice(config.commands.indexOf(c) + 1, 0, n); state.selected = n.id; markDirty(); render();
}
function deleteCommand() {
  var c = byId(state.selected); if (c == null) return;
  if (!confirm('Delete "' + c.name + '"?')) return;
  config.commands.splice(config.commands.indexOf(c), 1); state.selected = null; markDirty(); render();
}
function addGroup() {
  var name = prompt('Name of the new group'); if (!name) return; name = name.trim().substring(0, 64);
  if (!name || config.groups.indexOf(name) >= 0) return;
  config.groups.push(name); state.filter = name; markDirty(); render();
}
function renameGroup(g) {
  var name = prompt('Rename group', g); if (!name) return; name = name.trim().substring(0, 64);
  if (!name || name == g || config.groups.indexOf(name) >= 0) return;
  config.groups[config.groups.indexOf(g)] = name;
  if (config.groupColors[g] != null) { config.groupColors[name] = config.groupColors[g]; delete config.groupColors[g]; }
  if (config.groupScopes[g] != null) { config.groupScopes[name] = config.groupScopes[g]; delete config.groupScopes[g]; }
  config.commands.forEach(function (c) { if (c.group == g) c.group = name; });
  if (state.filter == g) state.filter = name;
  markDirty(); render();
}
function moveGroup(g, dir) {
  var i = config.groups.indexOf(g), j = i + dir; if (i < 0 || j < 0 || j >= config.groups.length) return;
  config.groups.splice(i, 1); config.groups.splice(j, 0, g); markDirty(); render();
}
function deleteGroup(g) {
  var n = config.commands.filter(function (c) { return c.group == g; }).length;
  if (!confirm('Delete group "' + g + '"?' + (n ? ' Its ' + n + ' command(s) are kept without a group.' : ''))) return;
  config.groups.splice(config.groups.indexOf(g), 1);
  delete config.groupColors[g];
  delete config.groupScopes[g];
  config.commands.forEach(function (c) { if (c.group == g) c.group = ''; });
  if (state.filter == g) state.filter = null;
  markDirty(); render();
}
function loadDefaults() {
  if (config.commands.length && !confirm('Replace the current ' + config.commands.length + ' command(s) with the example set? Nothing is saved until you click "Save changes".')) return;
  config = JSON.parse(JSON.stringify(defaults)); state.selected = null; state.filter = null; markDirty(); render();
}

// ---- drag to reorder / regroup ----
var dragId = null;
function dragStart(e) { dragId = e.currentTarget.getAttribute('data-id'); e.currentTarget.classList.add('dragging'); e.dataTransfer.effectAllowed = 'move'; try { e.dataTransfer.setData('text/plain', dragId); } catch (ex) { } }
function dragEnd(e) { e.currentTarget.classList.remove('dragging'); dragId = null; document.querySelectorAll('.keys.over').forEach(function (k) { k.classList.remove('over'); }); }
function dragOver(e) { if (dragId == null) return; e.preventDefault(); e.dataTransfer.dropEffect = 'move'; e.currentTarget.classList.add('over'); }
function dragLeave(e) { e.currentTarget.classList.remove('over'); }
function drop(e) {
  e.preventDefault(); if (dragId == null) return;
  var container = e.currentTarget, group = container.getAttribute('data-group');
  var moving = byId(dragId); if (moving == null) return;
  // Find the key we dropped before (by x/y), if any.
  var target = null;
  var keys = container.querySelectorAll('.key[data-id]');
  for (var i = 0; i < keys.length; i++) {
    var r = keys[i].getBoundingClientRect();
    if (keys[i].getAttribute('data-id') == dragId) continue;
    if ((e.clientY < r.top + r.height) && (e.clientX < r.left + r.width / 2 || e.clientY < r.top)) { target = keys[i].getAttribute('data-id'); break; }
  }
  config.commands.splice(config.commands.indexOf(moving), 1);
  moving.group = group;
  if (target) { config.commands.splice(config.commands.indexOf(byId(target)), 0, moving); }
  else { // append after the last command of this group
    var last = -1; config.commands.forEach(function (c, i) { if (c.group == group) last = i; });
    config.commands.splice(last + 1, 0, moving);
  }
  markDirty(); render();
}

// ---- save / import / export ----
function save() {
  if (state.saving) return;
  state.saving = true; renderDirty();
  var d = document.getElementById('dirty'); d.className = 'dirty on'; d.lastElementChild.textContent = 'Saving…';
  fetch(window.location.pathname + '?pin=quickcommands', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'config=' + encodeURIComponent(JSON.stringify(config)) })
    .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'Server answered ' + r.status }; }); })
    .then(function (j) {
      state.saving = false;
      if (j.ok) { config = j.config; state.dirty = false; render(); d.className = 'dirty saved'; d.lastElementChild.textContent = 'Saved'; toast('Saved. Devices pick up the new keys right away.'); }
      else { renderDirty(); d.className = 'dirty err'; d.lastElementChild.textContent = j.error || 'Could not save'; }
    })
    .catch(function (e) { state.saving = false; renderDirty(); d.className = 'dirty err'; d.lastElementChild.textContent = 'Could not save: ' + e.message; });
}
function exportJson() {
  var blob = new Blob([JSON.stringify(config, null, 2)], { type: 'application/json' });
  var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'quickcommands.json'; document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);
}
function importJson() { document.getElementById('importFile').click(); }
function importFileChosen(e) {
  var f = e.target.files[0]; if (!f) return;
  var r = new FileReader();
  r.onload = function () {
    try {
      var j = JSON.parse(r.result);
      if (!Array.isArray(j.commands)) throw new Error('no "commands" list');
      var mode = config.commands.length ? (confirm('Add the ' + j.commands.length + ' imported command(s) to the current ones?\n\nOK = add, Cancel = replace everything.') ? 'add' : 'replace') : 'replace';
      if (mode == 'replace') { config = j; } else { j.commands.forEach(function (c) { c.id = uid(); config.commands.push(c); }); (j.groups || []).forEach(function (g) { if (config.groups.indexOf(g) == -1) config.groups.push(g); }); if (j.groupColors) { for (var gk in j.groupColors) { if (config.groupColors[gk] == null) config.groupColors[gk] = j.groupColors[gk]; } } }
      state.selected = null; markDirty(); render(); toast('Imported ' + j.commands.length + ' command(s). Save to keep them.');
    } catch (ex) { alert('That file is not a Quick Commands export: ' + ex.message); }
    e.target.value = '';
  };
  r.readAsText(f);
}
document.addEventListener('keydown', function (e) { if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() == 's') { e.preventDefault(); if (state.dirty) save(); } });
document.addEventListener('keydown', function (e) {
  if (e.key != 'Escape') return;
  var p = document.getElementById('scopePop');
  if (p && p.classList.contains('open')) { p.classList.remove('open'); return; }
  if (state.scopeGroup != null) { scopeCloseGroup(); }
});
// A click outside the target picker closes it.
document.addEventListener('click', function (e) {
  var p = document.getElementById('scopePop');
  if (p && p.classList.contains('open') && !(e.target.closest && e.target.closest('.addt'))) { p.classList.remove('open'); }
});
window.addEventListener('beforeunload', function (e) { if (state.dirty) { e.preventDefault(); e.returnValue = ''; } });

// ---- drag rail: resize the drawer, remember the width -----------------
(function () {
  var rail = document.getElementById('rail');
  try { var s = parseInt(localStorage.getItem('qc_drawer_w'), 10); if (s) setDrawerW(s, false); } catch (e) { }
  var dragging = false;
  rail.addEventListener('pointerdown', function (e) { dragging = true; rail.classList.add('on'); rail.setPointerCapture(e.pointerId); e.preventDefault(); });
  rail.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    var r = document.getElementById('mainRow').getBoundingClientRect();
    setDrawerW(r.right - e.clientX, false);
  });
  rail.addEventListener('pointerup', function (e) {
    if (!dragging) return;
    dragging = false; rail.classList.remove('on');
    var d = document.getElementById('drawer');
    setDrawerW(parseInt(d.style.width, 10) || 400, true);
  });
  rail.addEventListener('dblclick', function () { setDrawerW(400, true); });
  rail.addEventListener('keydown', function (e) {
    var d = document.getElementById('drawer'), w = parseInt(d.style.width, 10) || 400;
    if (e.key == 'ArrowLeft') { setDrawerW(w + 16, true); e.preventDefault(); }
    if (e.key == 'ArrowRight') { setDrawerW(w - 16, true); e.preventDefault(); }
  });
  window.addEventListener('resize', function () {
    var d = document.getElementById('drawer'), w = parseInt(d.style.width, 10);
    if (w) setDrawerW(w, false);
  });
  // Clicking the dimmed backdrop of the centered editor returns it to the side.
  document.getElementById('drawerOverlay').addEventListener('click', function (e) { if (e.target === this) toggleCenter(); });
  document.getElementById('scopeDlg').addEventListener('click', function (e) { if (e.target === this) scopeCloseGroup(); });
})();

render();
</script>
</body>
</html>
